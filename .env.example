# Postmark (https://postmarkapp.com) — used by /api/quote to send "Pedido de orçamento" emails.
# Server API token: Postmark → Servers → <server> → API Tokens
POSTMARK_SERVER_TOKEN=
# Verified sender signature or address on a verified domain, e.g. "Pedra Norte <geral@pedranorte.eu>"
POSTMARK_SENDER=
# Inbox that receives quote requests (optional, defaults to POSTMARK_SENDER)
POSTMARK_RECIPIENT=
